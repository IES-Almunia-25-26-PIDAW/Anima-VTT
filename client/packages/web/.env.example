# You do NOT need this file for normal play.
#
# URL auto-detection covers all three scenarios automatically:
#
#   Vite dev server (port 5173)
#     → API and WebSocket connect to the same host at :1000
#
#   Spring Boot direct (port 1000, via start-gm.bat)
#     → same-origin requests
#
#   Tunnel via HTTPS (localtunnel / ngrok, no explicit port)
#     → same-origin requests over wss:// / https://
#
# Only set these if you have an unusual split-host setup where
# the browser's host differs from the server's host.

VITE_API_URL=http://YOUR_SERVER_HOST:1000
VITE_WS_URL=ws://YOUR_SERVER_HOST:1000/game
